# .env.example
# ==============
# Template de variables d'environnement
# Copier ce fichier en .env et remplir avec vos vraies valeurs
# NE JAMAIS commiter .env sur GitHub !
#
# Récupérer les valeurs dans Firebase Console > Paramètres Projet > Clés Web

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456ghi789

# Environnement
NODE_ENV=development

# Commission AubeShop (%)
EXPO_PUBLIC_COMMISSION_RATE=0.10

# Coût livraison (EUR)
EXPO_PUBLIC_SHIPPING_COST=5.00

# URLs Backend (futur)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_PAYMENT_API_URL=https://api.flutterwave.com/v3

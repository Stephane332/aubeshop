# .env.example
# ============
# Modèle de configuration. Copiez ce fichier en .env et remplissez-le.
#
#   cp .env.example .env
#
# .env est exclu du suivi Git : il ne doit jamais être commité.
#
# Note : les variables préfixées EXPO_PUBLIC_ sont intégrées au paquet de
# l'application et donc publiques par nature. C'est normal pour une clé
# Firebase Web — ce sont les règles Firestore et Storage (firestore.rules,
# storage.rules) qui protègent réellement les données, pas le secret de
# ces clés. N'y mettez jamais de clé serveur ni de secret d'API.

# ============================================
# FIREBASE
# ============================================
# Console Firebase > Paramètres du projet > Vos applications > Web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ============================================
# RÈGLES COMMERCIALES
# ============================================
# Ces valeurs ont des valeurs par défaut dans lib/money.ts ; ne les
# renseignez que pour les surcharger.

# Commission AubeShop sur chaque vente, en fraction (0.10 = 10 %).
# Prélevée sur la part du vendeur, pas ajoutée au prix client.
EXPO_PUBLIC_COMMISSION_RATE=0.10

# Frais de livraison de la zone la plus proche, en FCFA (XOF).
# Le barème complet est défini par zone dans lib/money.ts :
# campus 500, quartier proche 1000, ville 1500, périphérie 2000.
EXPO_PUBLIC_SHIPPING_COST=500

# ============================================
# PAIEMENT (à venir)
# ============================================
# Flutterwave pour Mobile Money et carte bancaire.
# Seule la clé PUBLIQUE a sa place ici ; la clé secrète doit rester
# côté serveur, jamais dans l'application.
# EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

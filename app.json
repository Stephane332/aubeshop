{
  "expo": {
    "name": "AubeShop",
    "slug": "aubeshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aubeshop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#C81E3C",
    "description": "Marketplace du campus de l'Université Aube Nouvelle : achetez et vendez entre étudiants vérifiés, faites-vous livrer.",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bf.aubeshop.app",
      "infoPlist": {
        "CFBundleDisplayName": "AubeShop",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "bf.aubeshop.app",
      "adaptiveIcon": {
        "backgroundColor": "#C81E3C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.INTERNET", "android.permission.CAMERA"]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "AubeShop",
      "shortName": "AubeShop",
      "themeColor": "#C81E3C",
      "backgroundColor": "#F6F6F8",
      "display": "standalone",
      "startUrl": "/",
      "lang": "fr",
      "orientation": "portrait"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0D0D10"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "//": "Textes affichés par iOS dans la demande d'autorisation. Sans eux, l'accès aux photos fait planter l'app et l'App Store refuse la soumission.",
          "photosPermission": "AubeShop accède à vos photos pour illustrer vos produits et joindre votre justificatif d'inscription.",
          "cameraPermission": "AubeShop utilise l'appareil photo pour prendre vos produits en photo et photographier votre carte d'étudiant."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "//": "Renseigné automatiquement par `eas init` lors du premier build cloud."
      }
    }
  }
}

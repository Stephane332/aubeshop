{
  "name": "aubeshop_v04",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "//": "NODE_OPTIONS relève le tas de Node à 4 Go : le bundle fait plus de 2200 modules et la limite de 2 Go par défaut provoque un « heap out of memory » sur une machine modeste.",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --android",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --web",
    "build:web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo export --platform web --output-dir dist",
    "serve:web": "node scripts/serve-pwa.js",
    "icons": "node scripts/generate-icons.js",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "emulators": "firebase emulators:start",
    "seed": "node scripts/seed.js",
    "apk": "cross-env NODE_OPTIONS=--max-old-space-size=4096 node scripts/build-apk.js",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "date-fns": "^4.1.0",
    "expo": "~54.0.24",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "^17.0.8",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "firebase": "^12.6.0",
    "lottie-react-native": "^7.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-admin": "^14.5.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
